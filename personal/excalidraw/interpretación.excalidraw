      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aquí me está dando directamente el contenido del header, pensé que\npodría cambiar <span> por <img>, pero veo que en realidad importa una\nfuente de la que saca los iconos mediante las clases así que tal vez\nuse dos clases: una con BEM y la necesaria para el icono.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
